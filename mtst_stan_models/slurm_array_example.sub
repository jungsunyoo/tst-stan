#!/bin/bash
#SBATCH --job-name=mtst_ddm
#SBATCH --time=24:00:00
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --array=1-100
#SBATCH --output=logs/%x_%A_%a.out
#SBATCH --error=logs/%x_%A_%a.err

module load python/3.11  # adjust to your cluster
source ~/venv/bin/activate

CSV=hddm2_fixed_final_5states.csv
S=5
SUBJ=${SLURM_ARRAY_TASK_ID}

python fit_ddm_cache_subject.py --csv $CSV --states $S --subj $SUBJ --outdir stan_ddm_cache_out
